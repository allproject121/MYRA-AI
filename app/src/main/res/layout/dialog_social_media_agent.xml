<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_card"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_social" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.05"
                android:text="SOCIAL MEDIA AGENT"
                android:textColor="@color/white"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="Instagram &amp; Facebook Automation Gate"
                android:textColor="@color/text_secondary"
                android:textSize="10sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/dialogCloseBtn"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close"
            android:src="@drawable/ic_close" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="12dp"
        android:background="#22FFFFFF" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="360dp"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Platform Selector -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="SELECT TARGET PLATFORM &amp; FORMAT"
                android:textColor="@color/primary_red"
                android:textSize="10sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/socialPlatformRadioGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/radioInstagram"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:checked="true"
                    android:text="Instagram"
                    android:textColor="@color/white"
                    android:textSize="12sp" />

                <RadioButton
                    android:id="@+id/radioFacebook"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Facebook"
                    android:textColor="@color/white"
                    android:textSize="12sp" />
            </RadioGroup>

            <!-- Action Format -->
            <RadioGroup
                android:id="@+id/socialFormatRadioGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/radioFeed"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:checked="true"
                    android:text="Feed Post"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />

                <RadioButton
                    android:id="@+id/radioStory"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Story"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />

                <RadioButton
                    android:id="@+id/radioReel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Reel"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
            </RadioGroup>

            <!-- Caption Editor -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="monospace"
                android:text="POST CAPTION / DESCRIPTION"
                android:textColor="@color/primary_red"
                android:textSize="10sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/socialCaptionField"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_input_field"
                android:gravity="top|start"
                android:hint="Type caption or let MYRA generate one..."
                android:padding="10dp"
                android:textColor="@color/white"
                android:textColorHint="@color/text_hint"
                android:textSize="12sp" />

            <!-- AI Suggest Caption Button -->
            <Button
                android:id="@+id/btnSuggestCaption"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginTop="6dp"
                android:backgroundTint="#24243A"
                android:text="✨ Generate Smart Caption"
                android:textColor="@color/speaking_purple"
                android:textSize="10sp" />

            <!-- Confirmation Gate Section -->
            <LinearLayout
                android:id="@+id/confirmationGateLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_prime_card"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:text="🛡️ AUTOMATION CONFIRMATION GATE"
                    android:textColor="@color/primary_red"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/gateStatusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Draft prepared! Confirmation is strictly required before sharing to prevent accidental posts."
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnConfirmPublish"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/status_green"
                        android:text="Confirm &amp; Share 🚀"
                        android:textColor="@color/black"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btnRejectPublish"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:backgroundTint="#331A1A"
                        android:text="Discard / Cancel ❌"
                        android:textColor="@color/primary_red"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
